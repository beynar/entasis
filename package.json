	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"prepack": "svelte-kit sync && npm run check:component-contract && npm run check:feature-chips && npm run check:semantic-theme-tokens && npm run check:template-purity && npm run check:public-api-contract && svelte-package && npm run check:packed-library && npm run check:package-consumer && npm run check:doc-fences && node tooling/check-document-viewer-package.mjs && publint",
		"check:document-viewer-package": "node tooling/check-document-viewer-package.mjs",
		"check:semantic-theme-tokens": "node tooling/check-semantic-theme-tokens.mjs",
		"check:template-purity": "node tooling/check-template-purity.mjs",
		"check:public-api-contract": "node tooling/check-public-api-contract.mjs",
		"check:readme-tokens": "node tooling/check-readme-tokens.mjs",
		"check:package-consumer": "node tooling/check-package-consumer.mjs",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run check:readme-tokens",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"generate:component-contract": "node tooling/component-contract/generate.mjs",
		"check:component-contract": "node tooling/component-contract/generate.mjs --check",
		"check:packed-library": "node tooling/check-packed-library.mjs",
		"test:contracts": "node --test tooling/component-contract/verify-checks.mjs",
		"check:doc-fences": "node tooling/check-doc-fences.mjs",
		"check:feature-chips": "node tooling/check-feature-chips.mjs",
		"release": "node tooling/release.mjs"
	},
